# Archivo de ejemplo de variables de entorno para PER Tests
# Copia este archivo a .env y ajusta los valores según tu entorno

# ==========================================
# CONFIGURACIÓN DE RUTAS Y DIRECTORIOS
# ==========================================

# Directorio base de datos (relativo al directorio del proyecto)
# PER_DATA_DIR=data

# Directorio de archivos YAML de exámenes
# PER_EXAMS_DIR=data/exams

# Directorio de PDFs de preguntas originales
# PER_RAW_QUESTIONS_DIR=data/raw/questions

# Directorio de PDFs de respuestas originales
# PER_RAW_ANSWERS_DIR=data/raw/answers

# Directorio de backups de archivos YAML
# PER_BACKUPS_DIR=data/backups

# Directorio de archivos extraídos temporalmente
# PER_EXTRACTED_DIR=extracted_answers

# Directorio de archivos estáticos del frontend
# PER_STATIC_DIR=static

# ==========================================
# CONFIGURACIÓN DEL SERVIDOR WEB
# ==========================================

# Host del servidor (0.0.0.0 para permitir conexiones externas)
# PER_HOST=0.0.0.0

# Puerto del servidor
# PER_PORT=8002

# Recarga automática en desarrollo (true/false)
# PER_RELOAD=true

# Nivel de logging (debug, info, warning, error, critical)
# PER_LOG_LEVEL=info

# ==========================================
# CONFIGURACIÓN DE LA API
# ==========================================

# Título de la API
# PER_API_TITLE=PER Tests API

# Descripción de la API
# PER_API_DESCRIPTION=API para generar y corregir exámenes aleatorios de PER España

# Versión de la API
# PER_API_VERSION=1.0.0

# ==========================================
# CONFIGURACIÓN DE EXÁMENES
# ==========================================

# Número de preguntas por defecto en exámenes
# PER_DEFAULT_NUM_QUESTIONS=45

# Tiempo de vida de exámenes en memoria (horas)
# PER_EXAM_TTL_HOURS=2

# ==========================================
# CONFIGURACIÓN DE PROCESAMIENTO
# ==========================================

# Umbral de confianza para OCR (0.0 a 1.0)
# PER_OCR_CONFIDENCE_THRESHOLD=0.7

# DPI para conversión de PDFs a imágenes
# PER_PDF_DPI=300

# ==========================================
# CONFIGURACIÓN DE DESARROLLO
# ==========================================

# Modo debug (true/false)
# PER_DEBUG=false

# ==========================================
# EJEMPLOS DE CONFIGURACIÓN PARA DIFERENTES ENTORNOS
# ==========================================

# Para desarrollo local (puerto alternativo para evitar conflictos):
# PER_PORT=8003
# PER_DEBUG=true
# PER_RELOAD=true
# PER_LOG_LEVEL=debug

# Para producción:
# PER_HOST=127.0.0.1
# PER_PORT=8000
# PER_DEBUG=false
# PER_RELOAD=false
# PER_LOG_LEVEL=warning

# Para contenedor Docker:
# PER_HOST=0.0.0.0
# PER_PORT=8000
# PER_DEBUG=false
# PER_RELOAD=false
